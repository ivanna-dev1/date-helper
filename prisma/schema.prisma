
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DateFormat {
  COFFEE
  WALK
  DINNER
  MOVIE
  SURPRISE
}

enum WhoPays {
  MY_TREAT
  SPLIT
  DECIDE_LATER
  GUEST_TREAT
}

enum InviteStatus {
  PENDING
  CONFIRMED
  DECLINED
  COUNTER
  CANCELLED
}

enum Party {
  AUTHOR
  GUEST
}

enum ResponseType {
  YES
  NO
  COUNTER
}

model Invite {
  id Int @id @default(autoincrement())

  // Three links to one invite, each opening a different page.
  publicToken String @unique
  secretToken String @unique
  friendToken String @unique

  // Only the latest suggestion is kept. turnToken is the author's link; a new guest suggestion replaces it. Null on old invites.
  turnToken      String? @unique
  lastProposedBy Party?

  // Latest words only, and who wrote them.
  turnMessage   String?
  lastMessageBy Party?

  authorName String
  message    String
  format     DateFormat
  whoPays    WhoPays?

  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  timeOptions  TimeOption[]
  placeOptions PlaceOption[]
  response     Response?

  // Options of the latest move; replaced by each new move, moved into the response on accept.
  turnTimes  TurnTime[]
  turnPlaces TurnPlace[]
}

model TurnTime {
  id Int @id @default(autoincrement())

  inviteId Int
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  startsAt DateTime

  @@index([inviteId])
}

model TurnPlace {
  id Int @id @default(autoincrement())

  inviteId Int
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  name String
  note String?

  @@index([inviteId])
}

model TimeOption {
  id Int @id @default(autoincrement())

  inviteId Int
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  startsAt DateTime

  chosenBy Response?

  @@index([inviteId])
}

model PlaceOption {
  id Int @id @default(autoincrement())

  inviteId Int
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  name String
  note String?

  chosenBy Response?

  @@index([inviteId])
}

model Response {
  id Int @id @default(autoincrement())

  inviteId Int    @unique
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  type           ResponseType
  respondentName String
  message        String?

  chosenTimeId  Int?         @unique
  chosenTime    TimeOption?  @relation(fields: [chosenTimeId], references: [id])
  chosenPlaceId Int?         @unique
  chosenPlace   PlaceOption? @relation(fields: [chosenPlaceId], references: [id])

  proposedTime      DateTime?
  proposedPlace     String?
  proposedPlaceNote String?

  createdAt DateTime @default(now())
}
