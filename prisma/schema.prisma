
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DateFormat {
  COFFEE
  WALK
  DINNER
  MOVIE
  SURPRISE
}

enum WhoPays {
  MY_TREAT // the author pays
  SPLIT
  DECIDE_LATER
  GUEST_TREAT // the invited person pays
}

enum InviteStatus {
  PENDING
  CONFIRMED
  DECLINED
  COUNTER // they suggested something else
  CANCELLED
}

enum Party {
  AUTHOR
  GUEST
}

enum ResponseType {
  YES
  NO
  COUNTER
}

model Invite {
  id Int @id @default(autoincrement())

  // Three links to one invite; knowing one must not give access to the others.
  publicToken String @unique
  secretToken String @unique
  friendToken String @unique

  // Only the latest suggestion matters and it overwrites the previous one (no history).
  // turnToken is the author's link for answering a guest's suggestion; each new
  // guest suggestion issues a new token, so an old link stops working.
  // Both are empty for older invitations.
  turnToken      String? @unique
  lastProposedBy Party?

  // Only the latest message and its writer are kept.
  turnMessage   String?
  lastMessageBy Party?

  authorName String
  message    String
  format     DateFormat
  whoPays    WhoPays?

  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  timeOptions  TimeOption[]
  placeOptions PlaceOption[]
  response     Response?

  // Options of the latest move; replaced by the next move, or moved into the response on accept.
  turnTimes  TurnTime[]
  turnPlaces TurnPlace[]
}

// One time of the latest move; lives until the next move.
model TurnTime {
  id Int @id @default(autoincrement())

  inviteId Int
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  startsAt DateTime

  @@index([inviteId])
}

model TurnPlace {
  id Int @id @default(autoincrement())

  inviteId Int
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  name String
  note String?
  photoUrl String?

  @@index([inviteId])
}

model TimeOption {
  id Int @id @default(autoincrement())

  inviteId Int
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  startsAt DateTime

  chosenBy Response?

  @@index([inviteId])
}

model PlaceOption {
  id Int @id @default(autoincrement())

  inviteId Int
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  name String
  note String?
  // Photo of the place; shown only inside the app, never in a messenger preview.
  photoUrl String?

  chosenBy Response?

  @@index([inviteId])
}

model Response {
  id Int @id @default(autoincrement())

  inviteId Int    @unique
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  type           ResponseType
  respondentName String
  message        String?

  chosenTimeId  Int?         @unique
  chosenTime    TimeOption?  @relation(fields: [chosenTimeId], references: [id])
  chosenPlaceId Int?         @unique
  chosenPlace   PlaceOption? @relation(fields: [chosenPlaceId], references: [id])

  proposedTime      DateTime?
  proposedPlace     String?
  proposedPlaceNote String?
  proposedPhotoUrl String?

  createdAt DateTime @default(now())
}
